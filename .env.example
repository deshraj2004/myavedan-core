# Root Domain Configuration
NEXT_PUBLIC_ROOT_DOMAIN=myavedan.com

# Core SSO & JWT Secret (Min 32 characters)
SSO_JWT_SECRET=myavedan-root-sso-secret-change-in-prod-min-32-chars

# Vault Master Key (AES-256-GCM 64-char Hexadecimal Key)
VAULT_MASTER_KEY_HEX=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Webhook Shared Secret for Event Ingestion
CENTRAL_WEBHOOK_SECRET=myavedan-webhook-secret-key-prod

# Automation Pipeline (n8n Webhook Target)
N8N_WORKFLOW_WEBHOOK_URL=https://n8n.myavedan.com/webhook/central-events

# Optional PostgreSQL / Supabase Database URL
# DATABASE_URL=postgresql://postgres:password@db.supabase.co:5432/postgres
